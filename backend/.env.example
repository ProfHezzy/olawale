# Environment variables for production (Render/Supabase)
NODE_ENV=production
PORT=3001

# Database Configuration
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres

# Individual DB variables (if not using DATABASE_URL)
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_NAME=postgres

# Security
JWT_SECRET=yoursecretkeyhere

# Mail Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
